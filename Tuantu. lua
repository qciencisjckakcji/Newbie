local baseValue = setmetatable({}, { __mode = "k" })
local lastWritten = setmetatable({}, { __mode = "k" })
local hitboxBase = setmetatable({}, { __mode = "k" })

local function scaleDamage(v)
	if not (v:IsA("NumberValue") or v:IsA("IntValue")) then return end
	if lastWritten[v] == nil or v.Value ~= lastWritten[v] then
		baseValue[v] = v.Value
	end
	local target = baseValue[v] * State.DamageMultiplier
	if v.Value ~= target then
		v.Value = target
	end
	lastWritten[v] = v.Value
end

local function applyTool(tool)
	if not tool:IsA("Tool") then return end

	local sv = tool:FindFirstChild("SettingValues")
	if sv then
		for _, name in ipairs({ "MaxDamageValue", "MinDamageValue" }) do
			local v = sv:FindFirstChild(name)
			if v then pcall(scaleDamage, v) end
		end
	end

	local atk = getPath(tool, "Animations", "AttackAnimations")
	if atk then
		local s = State.HitboxSize
		local target = Vector3.new(s, s, s)
		for _, anim in ipairs(atk:GetChildren()) do
			local hb = anim:FindFirstChild("HitboxSize")
			if hb and hb:IsA("Vector3Value") then
				if State.HitboxEnabled then
					if hitboxBase[hb] == nil then hitboxBase[hb] = hb.Value end
					if hb.Value ~= target then hb.Value = target end
				elseif hitboxBase[hb] and hb.Value ~= hitboxBase[hb] then
					hb.Value = hitboxBase[hb]
				end
			end
		end
	end
end

