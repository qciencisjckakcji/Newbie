local function getPath(root, ...)
	local cur = root
	for _, name in ipairs({ ... }) do
		if not cur then return nil end
		cur = cur:FindFirstChild(name)
	end
	return cur
end

local function childNames(folder)
	local t = {}
	if folder then
		for _, c in ipairs(folder:GetChildren()) do
			table.insert(t, c.Name)
		end
	end
	table.sort(t)
	return t
end

