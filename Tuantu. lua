local function getAttackSpeedValue()
	local units = workspace:FindFirstChild("Units")
	local unit = units and units:FindFirstChild(LocalPlayer.Name)
	local stats = unit and unit:FindFirstChild("CharStats")
	local v = stats and stats:FindFirstChild("AttackSpeed")
	if v and v:IsA("ValueBase") then return v end
	return nil
end

local function setAttackSpeed(val)
	local v = getAttackSpeedValue()
	if v and v.Value ~= val then
		pcall(function() v.Value = val end)
	end
end

