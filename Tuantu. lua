local function isInPlayerCharacter(inst)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character and inst:IsDescendantOf(p.Character) then return true end
	end
	return false
end

local function matchesLag(name)
	local n = (string.lower(name):gsub("[%s_%-]", ""))
	for _, pat in ipairs(LAG_PATTERNS) do
		if string.find(n, pat, 1, true) then return true end
	end
	return false
end

local function removeLagStructures()
	local removed = 0
	for _, inst in ipairs(workspace:GetDescendants()) do
		if matchesLag(inst.Name) and not isInPlayerCharacter(inst) then
			if pcall(function() inst:Destroy() end) then removed += 1 end
		end
	end
	return removed
end

local function removeNPCs()
	local targets = {}
	local abno = workspace:FindFirstChild("Abnormalities")
	if abno then
		for _, c in ipairs(abno:GetChildren()) do table.insert(targets, c) end
	end
	for _, m in ipairs(workspace:GetDescendants()) do
		if m:IsA("Model")
			and m.Name ~= LocalPlayer.Name
			and not Players:GetPlayerFromCharacter(m)
			and m:FindFirstChildOfClass("Humanoid")
			and not isInPlayerCharacter(m) then
			table.insert(targets, m)
		end
	end
	local n = 0
	for _, m in ipairs(targets) do
		if m.Parent and pcall(function() m:Destroy() end) then n += 1 end
	end
	return n
end

local function disableEffects()
	local n = 0
	for _, d in ipairs(workspace:GetDescendants()) do
		if EFFECT_CLASSES[d.ClassName] then
			if pcall(function() d.Enabled = false end) then n += 1 end
		end
	end
	return n
end

local hpGuard = false
local function bindHealth(hum)
	local last = hum.Health
	trackConn(hum.HealthChanged:Connect(function(hp)
		if hpGuard then return end
		if State.Invincible and hp < last then
			hpGuard = true
			hum.Health = last
			hpGuard = false
		else
			last = hp
		end
	end))
end

