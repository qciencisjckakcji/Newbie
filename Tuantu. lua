local function addButton(parent, text, cb)
	local b = baseButton(parent, text)
	trackConn(b.Activated:Connect(cb))
	return b
end

local function addToggle(parent, text, default, cb)
	local state = default
	local b = baseButton(parent, "")
	local function paint()
		b.Text = (state and "[ON]  " or "[OFF] ") .. text
		b.BackgroundColor3 = state and C.on or C.btn
	end
	paint()
	trackConn(b.Activated:Connect(function()
		state = not state
		paint()
		cb(state)
	end))
	return function(v)
		state = v
		paint()
	end
end

local function addInput(parent, label, default, cb)
	local current = default
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -8, 0, ROW)
	box.BackgroundColor3 = C.btn
	box.BorderSizePixel = 0
	box.Text = tostring(default)
	box.PlaceholderText = label
	box.ClearTextOnFocus = false
	box.TextColor3 = C.text
	box.PlaceholderColor3 = C.muted
	box.TextSize = FONT_SIZE
	box.Font = Enum.Font.GothamMedium
	box.TextXAlignment = Enum.TextXAlignment.Left
	corner(box, 6)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.Parent = box
	box.Parent = parent
	trackConn(box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n and n > 0 then
			current = n
			cb(n)
		else
			box.Text = tostring(current)
		end
	end))
end

local function addCycle(parent, label, options, default, cb)
	if #options == 0 then options = { "None" } end
	local idx = table.find(options, default) or 1
	local b = baseButton(parent, "")
	local function paint()
		b.Text = label .. ": " .. options[idx]
	end
	paint()
	trackConn(b.Activated:Connect(function()
		idx = idx % #options + 1
		paint()
		cb(options[idx])
	end))
end

